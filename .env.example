# Copy to .env and fill in. Never commit .env.

# --- Who is reporting (required: a report without a name and postal address is not processed) ---
REPORTER_NAME="Vorname Nachname"
REPORTER_ADDRESS="Musterstraße 1, 10115 Berlin"
REPORTER_EMAIL="you@example.com"
REPORTER_PHONE=""

# --- Outgoing mail (SMTP). For Gmail, create an app password: https://myaccount.google.com/apppasswords ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@example.com"
SMTP_PASSWORD=""

# 1 = write .eml files to the outbox folder instead of sending (default). Set to 0 to send for real.
DRY_RUN="1"

# Where things live (defaults shown)
# REPORTS_DIR="~/berlin-reports"          # inbox/, outbox/, sent/, history.jsonl
# GEOCODE="1"                             # reverse-geocode photo GPS via OpenStreetMap Nominatim
